# Supply-chain settings; README, "Dependencies", says why.
# No dependency install scripts run. package.json "allowScripts" also denies the
# three that exist (esbuild, workerd, fsevents); nothing here needs them.
ignore-scripts=true
# npm install and npm update only take versions published at least 7 days ago.
# npm ci installs the committed lockfile as it is.
min-release-age=7
save-exact=true
audit=true
