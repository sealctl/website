{
  "name": "sealctl-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && wrangler pages dev dist --port 8788",
    "check": "node scripts/check-tokens.mjs && html-validate \"dist/**/*.html\" && linkinator dist --recurse --clean-urls --check-fragments --skip \"^https://\"",
    "check:external": "linkinator dist --recurse --clean-urls"
  },
  "devDependencies": {
    "html-validate": "11.21.1",
    "linkinator": "8.1.0",
    "marked": "18.2.1",
    "wrangler": "4.162.0"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  },
  "allowScripts": {
    "esbuild": false,
    "workerd": false,
    "fsevents": false
  }
}
